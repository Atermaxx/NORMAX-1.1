<Window x:Class="NORMAX.Wallpaper.WallpaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="NORMAX Desktop"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        Background="Black"
        WindowStartupLocation="Manual">
    <Grid Background="Black">
        <!-- Centered video panel: sized to VideoPercentage of this window, everything else is pure black. -->
        <Border x:Name="VideoPanel" Background="Black"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.RenderTransform>
                <TranslateTransform x:Name="VideoPanelOffset"/>
            </Border.RenderTransform>
            <vlc:VideoView x:Name="VideoSurface" Background="Black"/>
        </Border>
    </Grid>
</Window>
